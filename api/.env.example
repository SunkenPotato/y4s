# Copy to api/.env (gitignored). Every value below is also the built-in dev default.
DATABASE_URL=postgres://corner:corner@localhost:5433/corner
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
MAIL_TRANSPORT=smtp            # smtp | resend | log
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Corner <hello@corner.local>"
RESEND_API_KEY=                # only used when MAIL_TRANSPORT=resend
ADMIN_EMAILS=admin@ucla.edu
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Optional tuning (not part of the contract)
# AUTH_RATE_PER_MIN=10
# WRITE_RATE_PER_MIN=30
# RUST_LOG=corner_api=info,tower_http=info
